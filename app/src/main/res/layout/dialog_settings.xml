<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Configuración" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Garajes" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="18dp"/>
  <Button android:id="@+id/homeButton" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_action_button" android:text="Guardar Casa" android:textColor="@color/white" android:textAllCaps="false"/>
  <Button android:id="@+id/home2Button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_action_button" android:text="Guardar Casa 2" android:textColor="@color/white" android:textAllCaps="false"/>
  <Button android:id="@+id/workButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_action_button" android:text="Guardar Trabajo" android:textColor="@color/white" android:textAllCaps="false"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aparcamiento automático" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="20dp"/>
  <Button android:id="@+id/bluetoothButton" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_primary_button" android:text="Configurar Bluetooth del coche" android:textColor="@color/white" android:textAllCaps="false"/>
  <TextView android:id="@+id/autoStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:layout_marginTop="8dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Where Is My Car · v1.9.27 · GAIKA" android:textColor="@color/muted2" android:gravity="center" android:layout_marginTop="24dp"/>
 </LinearLayout>
</ScrollView>
