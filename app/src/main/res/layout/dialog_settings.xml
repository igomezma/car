<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- CABECERA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/settingsBackButton"
            android:layout_width="38dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/white"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Where Is My Car"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GAIKA · PERSONALIZA TU COCHE"
                android:textColor="@color/orange"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ZONA 1 · SELECTOR DE COCHE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:text="Elige tu coche"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/carPreview"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:adjustViewBounds="false"
        android:cropToPadding="true"
        android:scaleType="fitCenter" />

    <!-- CARRUSEL DE COCHES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/carChoice0"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:contentDescription="Troncomóvil" />

        <ImageButton
            android:id="@+id/carChoice1"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:contentDescription="Candy Car" />

        <ImageButton
            android:id="@+id/carChoice2"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:contentDescription="Cloud Car" />

        <ImageButton
            android:id="@+id/carChoice3"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:contentDescription="Space Car" />

        <ImageButton
            android:id="@+id/carChoice4"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:contentDescription="Bubble Car" />

        <ImageButton
            android:id="@+id/carChoice5"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:contentDescription="Cardboard Car" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/muted2" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/muted2" />

    <!-- ZONA 3 · APARCAMIENTO AUTOMÁTICO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="27dp"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:text="@string/auto_parking"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/autoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/disabled"
                android:textColor="@color/orange"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/autoDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bt_not_configured"
                android:textColor="@color/muted"
                android:textSize="9sp" />

        </LinearLayout>

        <Button
            android:id="@+id/configureCarBluetoothButton"
            android:layout_width="115dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/configure_bt_short"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="10sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/autoPermission"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:text="@string/auto_location_pending"
        android:textColor="@color/muted"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/autoLastEvent"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/no_events"
        android:textColor="@color/muted2"
        android:textSize="9sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/autoPermissionsButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:text="@string/auto_permissions_short"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="9sp" />

        <Button
            android:id="@+id/testAutoParkingButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/test_auto_short"
            android:textAllCaps="false"
            android:textSize="9sp" />

        <Button
            android:id="@+id/disableAutoParkingButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/disable_auto_short"
            android:textAllCaps="false"
            android:textSize="9sp" />

    </LinearLayout>

    <!-- PIE -->
    <TextView
        android:id="@+id/settingsVersionText"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center"
        android:text="Where Is My Car · v1.9.22 · GAIKA"
        android:textColor="@color/muted2"
        android:textSize="9sp" />

</LinearLayout>
