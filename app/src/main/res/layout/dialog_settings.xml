<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aparcamiento automático"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Desactivado"
            android:textColor="@color/orange"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autoDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Bluetooth del coche: no configurado"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/autoPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ubicación automática: pendiente"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/autoLastEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Todavía sin eventos"
            android:textColor="@color/muted2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/configureCarBluetoothButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_primary_button"
            android:text="Bluetooth de mi coche"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/trackerBluetoothButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_outline_button"
            android:enabled="false"
            android:text="Tracker Bluetooth · Próximamente"
            android:textAllCaps="false"
            android:textColor="@color/muted2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/autoPermissionsButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ghost_button"
            android:text="Permisos para guardado automático"
            android:textAllCaps="false"
            android:textColor="@color/orange"
            android:textSize="13sp" />

        <Button
            android:id="@+id/testAutoParkingButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_ghost_button"
            android:text="Probar guardado automático"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/disableAutoParkingButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_ghost_button"
            android:text="Desactivar aparcamiento automático"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="v1.4 beta · El guardado manual sigue funcionando como antes. El tracker Bluetooth todavía no está programado."
            android:textColor="@color/muted2"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
